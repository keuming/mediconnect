{
  "version": 2,
  "builds": [{ "src": "backend/server.js", "use": "@vercel/node", "config": { "includeFiles": ["backend/routes/**","backend/config/**","backend/middleware/**"] } }],
  "routes": [
    { "src": "/api/(.*)", "methods": ["GET","POST","PUT","DELETE","PATCH","OPTIONS"], "dest": "backend/server.js" },
    { "src": "/(.*)", "dest": "backend/server.js" }
  ]
}
