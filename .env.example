NODE_ENV=development
PORT=5000

# PostgreSQL (Vérifiez bien que le nom correspond à votre DB locale)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediconnect_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe

# JWT - À changer impérativement en production
JWT_SECRET=votre_secret_jwt_tres_long_et_securise
JWT_EXPIRES_IN=7d

# URLs des différents clients de l'écosystème
FRONTEND_URL=http://localhost:3000
MOBILE_URL=http://localhost:19000
RDV_SITE_URL=http://localhost:3001

# Gestion des fichiers (Chemin relatif au dossier backend)
MAX_FILE_SIZE=10mb
UPLOAD_DIR=uploads/