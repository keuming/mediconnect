# ═══════════════════════════════════════════════════
#  MediConnect Backend — Variables d'environnement
#  Copiez vers .env et remplissez les valeurs
#  ⚠️  Ne JAMAIS committer .env dans Git !
# ═══════════════════════════════════════════════════

NODE_ENV=production

# PostgreSQL Neon (DATABASE_URL recommandé pour Vercel)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Fallback variables séparées (dev local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediconnect_db
DB_USER=postgres
DB_PASSWORD=votre_mdp
DB_SSL=false

# JWT — générer: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_chaine_aleatoire_64_caracteres
JWT_EXPIRES_IN=7d

# CORS — URL exacte du frontend (sans slash final)
FRONTEND_URL=https://votre-frontend.vercel.app

# Uploads (Vercel: /tmp/ — lecture seule ailleurs)
UPLOAD_DIR=/tmp/
