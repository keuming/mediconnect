{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "routes/**",
          "config/**",
          "middleware/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["GET","POST","PUT","DELETE","PATCH","OPTIONS"],
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
