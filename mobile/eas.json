{
  "cli": {
    "version": "12.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://mediconnect-backend-v2.vercel.app",
        "NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}