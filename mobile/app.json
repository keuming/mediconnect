{
  "expo": {
    "name": "MediConnect Africa",
    "slug": "mediconnect-africa",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "mediconnect",
    "backgroundColor": "#060E18",
    "splash": {
      "backgroundColor": "#060E18",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "android": {
      "package": "cloud.mediconnect4africa",
      "adaptiveIcon": {
        "backgroundColor": "#0A8F58",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "cloud.mediconnect4africa"
    },
    "extra": {
      "apiUrl": "https://mediconnect-backend-v2.vercel.app",
      "eas": {
        "projectId": "6e112d1f-9189-4889-afb8-4ec52b219f63"
      }
    },
    "owner": "keumingo",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}