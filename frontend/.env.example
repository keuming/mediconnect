# ════════════════════════════════════════════════════════
#  MediConnect Frontend — Variables d'environnement
#  Pour le dev local  : copiez vers .env.local
#  Pour Vercel prod   : ajoutez dans Settings > Env Vars
#  ⚠️  Ne JAMAIS committer .env.local dans Git !
# ════════════════════════════════════════════════════════

# URL du backend (SANS /api à la fin — le code l'ajoute automatiquement)
# Dev local  : http://localhost:5000
# Vercel prod: https://mediconnect-alpha-azure.vercel.app
REACT_APP_API_URL=http://localhost:5000

# URL Socket.IO (même URL que l'API, sans /api)
REACT_APP_SOCKET_URL=http://localhost:5000
