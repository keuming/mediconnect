# ⚠️  IMPORTANT: L'URL doit se terminer par /api
# Exemple correct:   https://mon-backend.railway.app/api
# Exemple INCORRECT: https://mon-backend.railway.app   (sans /api)
# Exemple INCORRECT: https://mon-backend.railway.app/  (sans api)

REACT_APP_API_URL=http://localhost:5000/api

# URL Socket.IO (même serveur que l'API, sans /api)
REACT_APP_SOCKET_URL=http://localhost:5000
